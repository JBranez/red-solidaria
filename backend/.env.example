# Lo genera setup.ps1 a partir del .env de la raíz (sin credenciales administrativas ni de seed).
APP_ENV=development
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=RedSolidaria
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes
DB_APP_USER=redsolidaria_app
DB_APP_PASSWORD=
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:4200
