# ============================================================================
# Copie este archivo a .env  — o, mejor, ejecute .\setup.ps1, que lo genera con
# secretos aleatorios. NUNCA suba .env al repositorio (está en .gitignore).
# ============================================================================
APP_ENV=development

# --- SQL Server -------------------------------------------------------------
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=RedSolidaria
DB_DRIVER=ODBC Driver 18 for SQL Server
# Solo desarrollo local. En producción: no (e instale un certificado confiable).
DB_TRUST_SERVER_CERTIFICATE=yes

# Cuenta de la APLICACIÓN (solo EXECUTE). La crea database/09_permissions.sql
DB_APP_USER=redsolidaria_app
DB_APP_PASSWORD=

# --- API ----------------------------------------------------------------------
# Mínimo 32 caracteres aleatorios.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:4200

# --- Solo para inicializar la base (scripts de Python; no los usa la API) ------
# Cuenta administrativa. Déjela VACÍA para usar autenticación de Windows (recomendado).
MSSQL_SA_USER=sa
MSSQL_SA_PASSWORD=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Clave compartida de las cuentas de demostración (solo desarrollo).
SEED_DEMO_PASSWORD=

# --- Docker Compose / despliegue público ------------------------------------
DOMAIN=red-solidaria.example.com
ACCEPT_EULA=Y
MSSQL_PID=Express
